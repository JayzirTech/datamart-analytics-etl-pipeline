# ==============================================================================
# DATAMART S.A.S. - CONFIGURACIÓN DE VARIABLES DE ENTORNO (.env.example)
# ==============================================================================
# Copia este archivo a '.env' antes de ejecutar: docker-compose up -d
# NOTA: Ninguna contraseña ni credencial real debe versionarse en Git.
# ==============================================================================

# --- Airflow Core & Security ---
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.

# Credenciales de Administrador para la UI de Airflow (http://localhost:8080)
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=admin
_AIRFLOW_WWW_USER_ROLE=Admin
_AIRFLOW_WWW_USER_EMAIL=admin@datamart.com

# --- Airflow Metadata Database (PostgreSQL 1 - Interno) ---
POSTGRES_AIRFLOW_USER=airflow
POSTGRES_AIRFLOW_PASSWORD=airflow_secret_password
POSTGRES_AIRFLOW_DB=airflow_metadata
POSTGRES_AIRFLOW_PORT=5432

# --- Repositorio Analítico / Data Warehouse (PostgreSQL 2 - DWH) ---
DWH_DB_USER=dwh_user
DWH_DB_PASSWORD=dwh_secret_password
DWH_DB_NAME=datamart_dwh
DWH_INTERNAL_PORT=5432
DWH_HOST_PORT=5433

# --- Message Broker para CeleryExecutor (RabbitMQ) ---
RABBITMQ_DEFAULT_USER=airflow_broker
RABBITMQ_DEFAULT_PASS=broker_secret_password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# --- Microservicio Catálogo de Productos (FastAPI) ---
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0

# --- Parámetros Operativos del Pipeline (Airflow Variables) ---
RAW_DATA_PATH=/opt/airflow/data/raw
FASTAPI_BASE_URL=http://fastapi_products:8000
PIPELINE_ENVIRONMENT=development

# --- Credenciales de Kaggle (Opcionales - para descarga autenticada si aplica) ---
# KAGGLE_USERNAME=
# KAGGLE_KEY=
