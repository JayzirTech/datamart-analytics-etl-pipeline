// Instrucción: Copiar este código y pegarlo en https://dbdiagram.io/
// ============================================================================

Table dim_products {
  product_key integer [pk, increment]
  stock_code varchar(50) [unique, not null]
  canonical_description varchar(255) [not null]
  category_name varchar(100) [not null]
  supplier_country varchar(100)
  is_active boolean [default: true]
  created_at_utc timestamptz
  updated_at_utc timestamptz
}

Table dim_customers {
  customer_key integer [pk, increment]
  customer_id varchar(50) [unique, not null]
  customer_name varchar(150) [not null]
  customer_type varchar(20) [not null, note: "IDENTIFICADO o ANONIMO"]
  country varchar(100)
  first_seen_utc timestamptz
  created_at_utc timestamptz
}

Table dim_exchange_rates {
  currency_code varchar(10) [pk]
  currency_name varchar(100) [not null]
  country_default varchar(100) [not null]
  rate_to_usd numeric(14,6) [not null]
  source varchar(50)
  updated_at_utc timestamptz
}

Table fact_sales {
  sale_key bigint [pk, increment]
  invoice_no varchar(50) [not null]
  invoice_date date [not null]
  invoice_timestamp_utc timestamptz [not null]
  product_key integer [not null, ref: > dim_products.product_key]
  customer_key integer [not null, ref: > dim_customers.customer_key]
  country varchar(100) [not null]
  quantity integer [not null, note: "Mayor a 0"]
  currency_original varchar(10) [not null]
  unit_price_original numeric(12,4) [not null]
  exchange_rate_to_usd numeric(14,6) [not null]
  unit_price numeric(12,4) [not null, note: "En USD"]
  gross_revenue numeric(14,4) [not null, note: "quantity * unit_price (USD)"]
  source_file varchar(50) [not null]
  batch_id varchar(100)
  loaded_at_utc timestamptz
}

Table fact_returns {
  return_key bigint [pk, increment]
  invoice_no varchar(50) [not null]
  invoice_date date [not null]
  invoice_timestamp_utc timestamptz [not null]
  product_key integer [not null, ref: > dim_products.product_key]
  customer_key integer [not null, ref: > dim_customers.customer_key]
  country varchar(100) [not null]
  quantity_returned integer [not null, note: "Valor positivo devuelto"]
  currency_original varchar(10) [not null]
  unit_price_original numeric(12,4) [not null]
  exchange_rate_to_usd numeric(14,6) [not null]
  unit_price numeric(12,4) [not null, note: "En USD"]
  return_amount numeric(14,4) [not null, note: "quantity_returned * unit_price (USD)"]
  source_file varchar(50) [not null]
  batch_id varchar(100)
  loaded_at_utc timestamptz
}

Table fact_daily_product_revenue {
  daily_summary_key bigint [pk, increment]
  invoice_date date [not null]
  product_key integer [not null, ref: > dim_products.product_key]
  gross_revenue numeric(14,4) [not null]
  return_amount numeric(14,4) [not null]
  net_revenue numeric(14,4) [not null, note: "gross_revenue - return_amount (USD)"]
  total_sold_qty integer [not null]
  total_returned_qty integer [not null]
}

Table audit_product_descriptions {
  stock_code varchar(50) [not null]
  raw_description varchar(255) [not null]
  frequency integer [not null]
}

Table rejected_records {
  record_id bigint [pk, increment]
  source_dataset varchar(50) [not null]
  raw_record jsonb [not null]
  rejection_reason varchar(150) [not null]
  batch_id varchar(100)
  rejected_at_utc timestamptz
}
